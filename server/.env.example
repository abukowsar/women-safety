PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=nirapad
JWT_SECRET=<long random string>
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=<base64 key>
CLIENT_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
